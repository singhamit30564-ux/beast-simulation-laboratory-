import random
from dataclasses import dataclass
from typing import List, Dict, Optional

@dataclass
class PAMSite:
    position: int
    strand: str
    sequence: str

class PAMScanner:
    """Mock scanner to find PAM sites and extract target regions."""
    def find(self, target: str, variant: str) -> List[PAMSite]:
        pams = []
        target = target.upper()
        
        # TODO: Bug 5 - Reverse complement scan for '-' strand missing. Add in future update.
        if variant in ['SpCas9', 'Sniper-Cas9']:
            for i in range(len(target) - 2):
                if target[i+1:i+3] == 'GG':  # Matches NGG
                    pams.append(PAMSite(position=i, strand='+', sequence=target[i:i+3]))
        return pams

    def get_target_region(self, sequence: str, pam: PAMSite) -> str:
        """Returns the 20bp target sequence upstream of the PAM."""
        if pam.strand == '+':
            start = max(0, pam.position - 20)
            return sequence[start:pam.position]
        return ""

@dataclass
class CutResult:
    efficiency: float
    indels: Dict[str, float]
    off_targets: List[Dict]
    repair_pathway: str
    cut_position: int

class Cas9Simulator:
    """Simulate Cas9 cutting and repair outcomes."""

    def __init__(self, variant: str = 'SpCas9', seed: Optional[int] = None):
        self.variant = variant
        self.pam_scanner = PAMScanner()
        # Bug 1 Fix: Reproducible RNG seed
        self.rng = random.Random(seed)

    def cut(self, target: str, pam: Optional[PAMSite] = None,
            repair_pathway: str = 'NHEJ', cell_type: str = 'HEK293') -> CutResult:
        
        target = target.upper().strip()
        
        # Bug 3 Fix: Sequence validation
        if not set(target).issubset(set('ATCG')):
            raise ValueError("Invalid DNA sequence: target contains non-ATCG characters.")

        # Bug 4 Fix: Typo-prone pathway input
        repair_pathway = repair_pathway.strip().upper()

        if pam is None:
            pams = self.pam_scanner.find(target, self.variant)
            if not pams:
                return CutResult(
                    efficiency=0.0,
                    indels={},
                    off_targets=[],
                    repair_pathway=repair_pathway,
                    cut_position=-1
                )
            pam = pams[0]

        efficiency = self._calculate_efficiency(target, pam, cell_type)
        indels = self._predict_indels(target, pam, repair_pathway)
        off_targets = self._scan_off_targets(target, pam)

        if pam.strand == '+':
            cut_position = pam.position - 3
        else:
            cut_position = pam.position + len(pam.sequence) + 3

        return CutResult(
            efficiency=efficiency,
            indels=indels,
            off_targets=off_targets,
            repair_pathway=repair_pathway,
            cut_position=cut_position
        )

    def _calculate_efficiency(self, sequence: str, pam: PAMSite, cell_type: str) -> float:
        base_eff = 85.0
        target_region = self.pam_scanner.get_target_region(sequence, pam)
        
        # Bug 8 Fix: GC% reliable only if target region is sufficiently long
        if len(target_region) >= 15:
            gc = (target_region.count('G') + target_region.count('C')) / len(target_region) * 100
            
            # Bug 6 Fix: Asymmetric GC logic corrected
            if 40 <= gc <= 60:
                base_eff += 10.0
            elif 30 <= gc < 40 or 60 < gc <= 70:
                pass  # Neutral efficiency
            else:
                base_eff -= 15.0  # Applies to <30 or >70

        cell_factors = {
            'HEK293': 1.0,
            'K562': 0.95,
            'IPSC': 0.80, # Made safe for case variations
            'T-CELL': 0.75,
        }
        base_eff *= cell_factors.get(cell_type.upper().strip(), 1.0)

        if self.variant == 'Sniper-Cas9':
            base_eff *= 0.90

        return min(99.0, max(0.0, base_eff))

    def _predict_indels(self, sequence: str, pam: PAMSite, pathway: str) -> Dict[str, float]:
        if pathway == 'NHEJ':
            return {'no_indel': 20.0, '1bp_deletion': 35.0, '2bp_deletion': 25.0, '3bp_deletion': 10.0, '1bp_insertion': 5.0, 'other': 5.0}
        elif pathway == 'HDR':
            return {'precise_repair': 70.0, 'no_repair': 15.0, 'erroneous_repair': 10.0, 'other': 5.0}
        else:
            return {'unknown': 100.0}

    def _scan_off_targets(self, sequence: str, pam: PAMSite, max_mismatches: int = 3) -> List[Dict]:
        target = self.pam_scanner.get_target_region(sequence, pam)
        off_targets = []
        
        # Bug 1 Fix: self.rng everywhere
        if self.rng.random() > 0.7 and len(target) >= 10:
            off_targets.append({
                # Bug 9 Fix: Randomized chromosome for now. TODO: implement real genome scan.
                'chromosome': f'chr{self.rng.randint(1, 22)}',
                'position': self.rng.randint(1000000, 2000000),
                # Bug 7 Fix: max_mismatches finally utilized
                'mismatches': self.rng.randint(1, max_mismatches),
                'sequence': target[:5] + '...' + target[-5:],
                # Bug 2 Fix: Name changed to indicate it's not the real Hsu matrix
                'simulated_cfd_score': round(self.rng.uniform(0.01, 0.3), 3) 
            })

        return off_targets

